<?xml version="1.0" encoding="utf-8"?>
<!-- 答对高亮：绿色光晕 + 绿色圆环 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#554FAE6A" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="5dp"
                android:color="@color/correct_green" />
        </shape>
    </item>
</layer-list>
