<?xml version="1.0" encoding="utf-8"?>
<!-- 兔子洞：草地 + 圆洞（青草绿） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#BFE3A8"
                android:centerColor="#8CC46B"
                android:endColor="#5E9445" />
        </shape>
    </item>
    <item android:bottom="12dp" android:left="22dp" android:right="22dp" android:top="10dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:startColor="#33240F"
                android:endColor="#51381C" />
        </shape>
    </item>
</layer-list>
