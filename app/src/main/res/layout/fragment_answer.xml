                android:importantForAccessibility="no"
                android:rotation="-38"
                android:src="@drawable/ic_hammer"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ============ 土洞 4 ============ -->
        <FrameLayout
            android:id="@+id/hole4"
            android:layout_width="0dp"
